import numpy as np
import json
import utils


def sigmoid(A):
    return 1 / (1 + np.exp(-A))
def mse_loss(output, label):
    n = len(output)
    return sum((output[i][0] - label[i][0]) ** 2 for i in range(n)) / n


def LearningNN():
    images,labels = utils.load_dataset()

    # weights_input_to_hidden = np.random.uniform(-0.5, 0.5,(150,2500))
    # weights_hidden_to_output= np.random.uniform(-0.5, 0.5,(10,150))
