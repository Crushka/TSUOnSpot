import numpy as np
import json
import utils

def matrix_multiply(A, B):
    rows_A, cols_A = len(A), len(A[0])
    cols_B = len(B[0])
    result = [[0.0] * cols_B for _ in range(rows_A)]
    for i in range(rows_A):
        for j in range(cols_B):
            s = 0.0
            for k in range(cols_A):
                s += A[i][k] * B[k][j]
            result[i][j] = s
    return result

def matrix_additon(A, B):
    return [[A[i][j] + B[i][j] for j in range(len(A[0]))] for i in range(len(A))]

def matrix_subtraction(A, B):
    return [[A[i][j] - B[i][j] for j in range(len(A[0]))] for i in range(len(A))]

def matrix_mult_by_scalar(A, scalar):
    return [[A[i][j] * scalar for j in range(len(A[0]))] for i in range(len(A))]

def matrix_transpose(A):
    return [[A[i][j] for i in range(len(A))] for j in range(len(A[0]))]

def vector_argmax(vector):
    flat = [vector[i][0] for i in range(len(vector))]
    return flat.index(max(flat))

def matrix_Hadamard_product(A, B):
    return [[A[i][j] * B[i][j] for j in range(len(A[0]))] for i in range(len(A))]

def one_minus_matrix(A):
    return [[1 - A[i][j] for j in range(len(A[0]))] for i in range(len(A))]


def sigmoid(A):
    return [[1 / (1 + np.exp(-A[i][j])) for j in range(len(A[0]))] for i in range(len(A))]
def mse_loss(output, label):
    n = len(output)
    return sum((output[i][0] - label[i][0]) ** 2 for i in range(n)) / n



def LearningNN():
    images, labels = utils.load_dataset()

    weights_input_to_hidden = np.random.uniform(-0.5, 0.5, (150, 2500)).tolist()
    weights_hidden_to_output = np.random.uniform(-0.5, 0.5, (10, 150)).tolist()

    bias_input_to_hidden  = [[0.0] for _ in range(150)]
    bias_hidden_to_output = [[0.0] for _ in range(10)]
    # bias_input_to_hidden, bias_hidden_to_output, weights_input_to_hidden, weights_hidden_to_output = Open("data_for_nn.json")

    epochs = 1
    e_loss = 0
    e_correct = 0
    learning_rate = 0.1

    for epoch in range(epochs):
        print(f"Epoch #{epoch}")

        for image, label in zip(images.tolist(), labels.tolist()):
            image = [[x] for x in image]
            label = [[x] for x in label]

            # sigmoid
            hidden_raw = matrix_additon(bias_input_to_hidden, matrix_multiply(weights_input_to_hidden, image))
            hidden = sigmoid(hidden_raw)

            output_raw = matrix_additon(bias_hidden_to_output, matrix_multiply(weights_hidden_to_output, hidden))
            output = sigmoid(output_raw)

            # MSE
            e_loss += mse_loss(output, label)
            e_correct += int(vector_argmax(output) == vector_argmax(label))

            # backpropagation(output)
            delta_output = matrix_subtraction(output, label)
            weights_hidden_to_output = matrix_subtraction(
                weights_hidden_to_output,
                matrix_mult_by_scalar(matrix_multiply(delta_output, matrix_transpose(hidden)), learning_rate)
            )
            bias_hidden_to_output = matrix_subtraction(
                bias_hidden_to_output,
                matrix_mult_by_scalar(delta_output, learning_rate)
            )

            # backpropagation(hidden)
            delta_hidden = matrix_Hadamard_product(
                matrix_multiply(matrix_transpose(weights_hidden_to_output), delta_output),
                matrix_Hadamard_product(hidden, one_minus_matrix(hidden))
            )
            weights_input_to_hidden = matrix_subtraction(
                weights_input_to_hidden,
                matrix_mult_by_scalar(matrix_multiply(delta_hidden, matrix_transpose(image)), learning_rate)
            )
            bias_input_to_hidden = matrix_subtraction(
                bias_input_to_hidden,
                matrix_mult_by_scalar(delta_hidden, learning_rate)
            )

        print(f"Loss: {round((e_loss / images.shape[0]) * 100, 3)}%")
        print(f"Accuracy: {round((e_correct / images.shape[0]) * 100, 3)}")
        e_loss = 0
        e_correct = 0
    return bias_input_to_hidden, bias_hidden_to_output, weights_input_to_hidden, weights_hidden_to_output

def Save(bias1, bias2, weights1, weights2, name):
    with open(name, 'w') as f:
        f.write(json.dumps({'bias1': bias1, 'bias2': bias2, 'weights1': weights1, 'weights2': weights2}))

def Open(name):
    with (open(name, 'r') as f):
        data = json.loads(f.read())
        return data['bias1'], data['bias2'], data['weights1'], data['weights2']

