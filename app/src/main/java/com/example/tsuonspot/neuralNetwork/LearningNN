    # bias_input_to_hidden  = [[0.0] for i in range(150)]
    # bias_hidden_to_output = [[0.0] for i in range(10)]
    bias_input_to_hidden, bias_hidden_to_output, weights_input_to_hidden, weights_hidden_to_output = Open("data_for_nn.json")

    epochs = 40
    e_loss = 0
    e_correct = 0
    learning_rate = 0.03

    for epoch in range(epochs):
        print(f"Epoch #{epoch}")
        for image, label in zip(images, labels):
            image = [[x] for x in image]
            label = [[x] for x in label]

            # sigmoid
            hidden_raw = bias_input_to_hidden + weights_input_to_hidden @ image
            hidden = sigmoid(hidden_raw)

            output_raw = bias_hidden_to_output + weights_hidden_to_output @ hidden
            output = sigmoid(output_raw)

            # MSE
            e_loss += 1 / len(output) * np.sum((output - label) ** 2, axis=0)
            e_correct += int(np.argmax(output) == np.argmax(label))

            # backpropagation(output)
            delta_output = output - label
            weights_hidden_to_output += -learning_rate * delta_output @ np.transpose(hidden)
            bias_hidden_to_output += -learning_rate * delta_output

            # backpropagation(hidden)
            delta_hidden = np.transpose(weights_hidden_to_output) @ delta_output * (hidden * (1 - hidden))
            weights_input_to_hidden += -learning_rate * delta_hidden @ np.transpose(image)
            bias_input_to_hidden += -learning_rate * delta_hidden


        print(f"Loss:{round((e_loss[0] / images.shape[0])*100,3)}%")
        print(f"Accuracy:{round((e_correct / images.shape[0])*100,3)}")
        e_loss = 0
        e_correct = 0
    return bias_input_to_hidden, bias_hidden_to_output, weights_input_to_hidden, weights_hidden_to_output

def save(bias1, bias2, weights1,weights2, name):
    def round_matrix(matrix):
        return [[round(x, 5) for x in row] for row in matrix]
    with open(name, 'w') as f:
        f.write(json.dumps({'bias1': round_matrix(bias1), 'bias2': round_matrix(bias2),
                            'weights1': round_matrix(weights1), 'weights2': round_matrix(weights2)}))

def Open(name):
    with (open(name, 'r') as f):
        data = json.loads(f.read())
        return np.array(data['bias1']), np.array(data['bias2']), np.array(data['weights1']), np.array(data['weights2'])




