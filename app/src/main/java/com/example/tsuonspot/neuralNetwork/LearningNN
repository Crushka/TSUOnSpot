import numpy as np
import os

def resize_mnist_to_50x50(images):
    num_images = images.shape[0]
    resized_images = np.zeros((num_images, 50, 50), dtype=np.uint8)
    for i in range(num_images):
        img = images[i]
        rows = [r for r in range(img.shape[0]) if any(img[r, c] > 0 for c in range(img.shape[1]))]
        cols = [c for c in range(img.shape[1]) if any(img[r, c] > 0 for r in range(img.shape[0]))]
        if len(rows) == 0:
            continue

        min_row, max_row = rows.min(), rows.max()
        min_col, max_col = cols.min(), cols.max()
        digit = img[min_row:max_row + 1, min_col:max_col + 1]
        target_size = 40
        h, w = digit.shape
        scale = target_size / max(h, w)
        new_h = int(h * scale)
        new_w = int(w * scale)
        scaled = np.zeros((new_h, new_w), dtype=np.uint8)
        for y in range(new_h):
            for x in range(new_w):
                orig_y = int(y / scale)
                orig_x = int(x / scale)
                if orig_y < h and orig_x < w:
                    scaled[y, x] = digit[orig_y, orig_x]
        y_offset = (50 - new_h) // 2
        x_offset = (50 - new_w) // 2
        resized_images[i, y_offset:y_offset + new_h, x_offset:x_offset + new_w] = scaled
    return resized_images


def prepare_and_save_dataset(save_file='mnist_50x50.npz'):
    if os.path.exists(save_file):
        with np.load(save_file) as f:
            x_train = f['x_train']
            y_train = f['y_train']
        return x_train, y_train

    with np.load("mnist.npz") as f:
        x_train = f['x_train']
        y_train = f['y_train']

    x_train = resize_mnist_to_50x50(x_train)

    np.savez_compressed(save_file, x_train=x_train, y_train=y_train)

    return x_train, y_train

def one_hot(label, num_classes=10):
    result = [0.0] * num_classes
    result[label] = 1.0
    return result

def load_dataset():
    x_train, y_train = prepare_and_save_dataset()

    x_train = x_train.astype("float32") / 255
    x_train = x_train.reshape(x_train.shape[0], -1)
    y_train = [one_hot(label) for label in y_train]
    return x_train, y_train


